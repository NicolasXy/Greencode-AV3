# Copie para .env e ajuste. Nunca versione o .env real.
DATABASE_URL="postgresql://greencode:greencode@localhost:5432/greencode"
# Obrigatorio: minimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-esta-chave-por-uma-aleatoria-com-no-minimo-32-caracteres"
JWT_EXPIRES_IN="30m"
PORT=3000
HOST="0.0.0.0"
BCRYPT_ROUNDS=12
# CORS_ORIGIN="http://localhost:5173"   (vazio = bloqueado; "*" = qualquer origem)
LOG_LEVEL="info"
SHUTDOWN_TIMEOUT_MS=10000
# Senha dos usuarios criados pelo seed (somente desenvolvimento)
# SEED_SENHA="Greencode#2026"

# ---- AV3: fila, worker e analises agendadas ----
# WORKER_ATIVO=true            (false = este processo so serve a API; rode `npm run worker` em outro)
# WORKER_INTERVALO_MS=2000     (de quanto em quanto tempo o worker olha a fila)
# FILA_MAX_TENTATIVAS=3        (tentativas por tarefa antes de falhar de vez)
# FILA_BACKOFF_MS=5000         (espera base entre tentativas; dobra a cada falha: 5s, 10s, 20s...)
# FILA_LEASE_MS=300000         (tempo maximo de uma tarefa em andamento antes de voltar para a fila)
# ANALISE_CRON="0 3 * * *"     (analise diaria as 03:00; vazio desativa o agendamento)
# ANALISE_TZ="America/Sao_Paulo"
# WEBHOOK_PERMITIR_REDE_PRIVADA=false   (true so em desenvolvimento: libera webhook para localhost/rede interna)
